{
  "manifest_version": 3,
  "name": "Fantalega Live Predictor",
  "short_name": "Fantalega Live",
  "version": "1.0.0",
  "description": "Proiezione del risultato dei match live della tua fantalega: voti, sostituzioni, modificatore difesa e fasce gol.",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://leghe.fantacalcio.it/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
